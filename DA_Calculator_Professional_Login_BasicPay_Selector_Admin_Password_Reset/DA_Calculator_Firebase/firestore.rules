rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'yB5FZBEVHCeIfpIYxCNTd0gCYeI3';
    }

    function validSessionDocument() {
      return request.resource.data.keys().hasAll(['version', 'accessEnabled', 'changedAt'])
        && request.resource.data.keys().hasOnly(['version', 'accessEnabled', 'changedAt'])
        && request.resource.data.version is int
        && request.resource.data.accessEnabled is bool
        && request.resource.data.changedAt is timestamp;
    }

    match /security/session {
      // Signed-in Admin and common user can read the small access-status document.
      allow read: if request.auth != null;

      // Only the exact Admin UID may initialize or change access settings.
      allow create: if isAdmin()
        && validSessionDocument()
        && request.resource.data.version == 0
        && request.resource.data.accessEnabled == true;

      // Every Admin action must increment the version exactly once.
      allow update: if isAdmin()
        && validSessionDocument()
        && request.resource.data.version == resource.data.version + 1;

      allow delete: if false;
    }

    // Deny every other Firestore document by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
